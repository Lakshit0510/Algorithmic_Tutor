{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Algorithmic Tutor",
  "version": "0.1.0",
  "identifier": "com.algorithmictutor.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @algorithmic-tutor/frontend dev",
    "beforeBuildCommand": "pnpm --filter @algorithmic-tutor/frontend build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [{ "title": "Algorithmic Tutor", "width": 1320, "height": 860, "minWidth": 980, "minHeight": 680, "resizable": true }],
    "security": { "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8787 http://127.0.0.1:8080; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com;" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/tutor-api", "binaries/llama-server"],
    "resources": ["resources/models/qwen2.5-1.5b-instruct-q4_k_m.gguf"],
    "windows": { "nsis": { "installerMode": "currentUser", "displayLanguageSelector": false } }
  }
}
