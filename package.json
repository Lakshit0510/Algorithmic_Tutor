{
  "name": "algorithmic-tutor",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm --filter @algorithmic-tutor/backend dev\" \"pnpm --filter @algorithmic-tutor/frontend dev\"",
    "build": "pnpm --filter @algorithmic-tutor/backend build && pnpm --filter @algorithmic-tutor/frontend build",
    "test": "pnpm --filter @algorithmic-tutor/backend test && pnpm --filter @algorithmic-tutor/frontend test",
    "lint": "pnpm --filter @algorithmic-tutor/backend lint && pnpm --filter @algorithmic-tutor/frontend lint",
    "desktop:dev": "pnpm prepare:sidecars && node frontend/node_modules/@tauri-apps/cli/tauri.js dev --config src-tauri/tauri.conf.json",
    "desktop:build": "pnpm prepare:sidecars && node frontend/node_modules/@tauri-apps/cli/tauri.js build --config src-tauri/tauri.conf.json",
    "desktop:build:offline": "pnpm prepare:sidecars && node frontend/node_modules/@tauri-apps/cli/tauri.js build --config src-tauri/tauri.offline.conf.json",
    "desktop:smoke": "pnpm prepare:sidecars && pnpm --filter @algorithmic-tutor/backend build",
    "prepare:sidecars": "tsx scripts/prepare-sidecars.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "@yao-pkg/pkg": "^6.20.0",
    "tsx": "^4.19.2"
  }
}
