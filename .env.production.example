# Required DNS name. Point its A record to this EC2 instance's Elastic IP first.
DOMAIN=tutor.example.com

# Docker image used on EC2. Change after GitHub Container Registry publishing.
IMAGE_NAME=ghcr.io/your-github-user/algorithmic-tutor
IMAGE_TAG=latest

NODE_ENV=production
APP_MODE=cloud
HOST=0.0.0.0
PORT=8787
SERVE_STATIC=true
STATIC_DIR=/app/public
CORS_ORIGIN=https://tutor.example.com

# Cloud mentor. This secret remains only on the server.
LLM_PROVIDER=openai
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.4
# Conservative guardrails under a 10 RPM / 50 RPD development quota.
OPENAI_MAX_OUTPUT_TOKENS=800
OPENAI_GLOBAL_RPM=4
OPENAI_DAILY_REQUEST_LIMIT=30
# Privacy-preserving anonymous context retention: rolling expiry after inactivity.
SESSION_DB_PATH=/data/tutor-sessions.db
SESSION_TTL_MINUTES=120
MAX_PROMPT_CHARS=20000

# Public abuse controls.
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=60
SESSION_CREATE_LIMIT=10
SESSION_REVIEW_LIMIT=40
