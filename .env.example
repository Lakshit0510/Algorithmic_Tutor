# Backend server
NODE_ENV=development
APP_MODE=local
HOST=127.0.0.1
PORT=8787
CORS_ORIGIN=http://localhost:5173,http://tauri.localhost,tauri://localhost
VITE_API_ORIGIN=http://localhost:8787
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=60
SESSION_CREATE_LIMIT=10
SESSION_REVIEW_LIMIT=40
SESSION_DB_PATH=data/tutor-sessions.db
SESSION_TTL_MINUTES=120
MAX_PROMPT_CHARS=20000
SERVE_STATIC=false
STATIC_DIR=public

# Cloud mode is optional. The application never exposes this value to the browser.
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Optional OpenAI cloud mode. Keep this secret on the backend only.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.4
OPENAI_MAX_OUTPUT_TOKENS=800
OPENAI_GLOBAL_RPM=4
OPENAI_DAILY_REQUEST_LIMIT=30

# Shipped local model runner. llama-server is started by Tauri on port 8080.
LOCAL_OPENAI_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_MODEL=qwen2.5-1.5b-instruct-q4_k_m.gguf

# Optional Ollama mode
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
